# ─────────────────────────────────────────────────────────────────────────────
# Local development defaults — committed so every worktree gets them.
# Values come from `supabase start` and only work with localhost.
# Override anything in .env.local (which stays gitignored).
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
