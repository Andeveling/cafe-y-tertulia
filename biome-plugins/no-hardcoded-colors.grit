engine biome(1.0)
language js(typescript, jsx)

or {
  JsStringLiteralExpression() as $literal where {
    $literal <: r".*(?:bg|text|border|ring)-(?:slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|white|black)-.*",
    register_diagnostic(
      span = $literal,
      message = "Use theme tokens instead of Tailwind palette colors.",
      severity = "error"
    )
  },
  JsStringLiteralExpression() as $literal where {
    $literal <: r".*#[0-9a-fA-F]{3,8}.*",
    register_diagnostic(
      span = $literal,
      message = "Use theme tokens instead of hex colors.",
      severity = "error"
    )
  }
}
