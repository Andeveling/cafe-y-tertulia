		"@vitest/browser-playwright": "4.1.11",
		"@vitest/coverage-v8": "4.1.11",
		"dependency-cruiser": "^18.4.0",
		"jsdom": "^30.1.0",
		"mockdate": "^3.0.5",
		"msw": "^2.15.0",
		"playwright": "latest",
