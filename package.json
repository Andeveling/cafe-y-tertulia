{
	"name": "cafe-y-tertulia",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun next dev",
		"build": "bun --bun next build",
		"start": "bun --bun next start",
		"lint": "npx @biomejs/biome check --",
		"format": "npx @biomejs/biome format --write",
		"depcruise": "npx depcruise app --config .dependency-cruiser.cjs --output-type err",
		"depcruise:graph": "npx depcruise app --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg",
		"sand": "bunx tsx .sandcastle/main.ts",
		"sand:clean": "sh scripts/clean-sandcastle-worktrees.sh",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"arch": "ts-archunit check",
		"arch:baseline": "ts-archunit baseline"
	},
	"dependencies": {
		"@ai-hero/sandcastle": "^0.12.0",
		"@base-ui/react": "^1.8.0",
		"@hookform/resolvers": "^5.9.1",
