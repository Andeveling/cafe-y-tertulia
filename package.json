		"@hugeicons/react": "^1.1.10",
		"@shadcn/react": "^0.3.1",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
